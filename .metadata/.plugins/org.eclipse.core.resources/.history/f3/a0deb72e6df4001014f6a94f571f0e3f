package com.college.auditorium.gui;

import com.college.auditorium.util.DBConnection;

import javax.swing.*;
import java.awt.*;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

public class ViewEventsGUI extends JFrame {

    JComboBox<String> eventBox;
    JComboBox<String> slotBox;

    int[] eventIds = new int[100];
    int[] slotIds = new int[100];
    int eventCount = 0;
    int slotCount = 0;

    int userId;

    public ViewEventsGUI(int userId) {

        this.userId = userId;

        setTitle("View Events");
        setSize(450, 250);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);

        setLayout(new GridLayout(4, 2, 10, 10));

        eventBox = new JComboBox<>();
        slotBox = new JComboBox<>();

        add(new JLabel("Select Event:"));
        add(eventBox);

        add(new JLabel("Select Slot:"));
        add(slotBox);

        JButton bookSeatBtn = new JButton("Book Seats");
        JButton backBtn = new JButton("Back");

        add(bookSeatBtn);
        add(backBtn);

        loadEvents();

        eventBox.addActionListener(e -> loadSlots());

        bookSeatBtn.addActionListener(e -> {
            int index = slotBox.getSelectedIndex();
            if (index < 0) {
                JOptionPane.showMessageDialog(this, "Select a slot");
                return;
            }
            int showtimeId = slotIds[index];
            new SeatSelectionGUI(userId, showtimeId);
        });

        backBtn.addActionListener(e -> dispose());

        setVisible(true);
    }

    private void loadEvents() {
        try {
            Connection con = DBConnection.getConnection();
            PreparedStatement ps = con.prepareStatement(
                "SELECT event_id, title FROM events"
            );
            ResultSet rs = ps.executeQuery();

            eventBox.removeAllItems();
            eventCount = 0;

            while (rs.next()) {
                eventBox.addItem(rs.getString("title"));
                eventIds[eventCount++] = rs.getInt("event_id");
            }

        } catch (Exception e) {
            JOptionPane.showMessageDialog(this, "Error loading events");
        }
    }

    private void loadSlots() {
        try {
            slotBox.removeAllItems();
            slotCount = 0;

            int index = eventBox.getSelectedIndex();
            if (index < 0) return;

            int eventId = eventIds[index];

            Connection con = DBConnection.getConnection();
            PreparedStatement ps = con.prepareStatement(
                "SELECT showtime_id, show_time FROM showtimes WHERE event_id=?"
            );
            ps.setInt(1, eventId);
            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                slotBox.addItem(rs.getString("show_time"));
                slotIds[slotCount++] = rs.getInt("showtime_id");
            }

        } catch (Exception e) {
            JOptionPane.showMessageDialog(this, "Error loading slots");
        }
    }
}
