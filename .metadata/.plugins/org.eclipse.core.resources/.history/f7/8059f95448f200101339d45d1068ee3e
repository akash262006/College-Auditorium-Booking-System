package com.movie;

import com.movie.util.DBConnection;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.util.Scanner;

public class BookTicket {

    public static void book(int userId) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Movie ID: ");
        int movieId = sc.nextInt();

        System.out.print("Enter Showtime (e.g. 6PM): ");
        String showtime = sc.next();

        System.out.print("Number of Seats: ");
        int seats = sc.nextInt();

        try {
            Connection con = DBConnection.getConnection();

            String sql = "INSERT INTO bookings (user_id, movie_id, showtime, seats) VALUES (?, ?, ?, ?)";
            PreparedStatement ps = con.prepareStatement(sql);

            ps.setInt(1, userId);
            ps.setInt(2, movieId);
            ps.setString(3, showtime);
            ps.setInt(4, seats);

            ps.executeUpdate();

            System.out.println("🎉 Ticket booked successfully!");

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
